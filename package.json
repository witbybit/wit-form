{
  "name": "wit-form",
  "version": "0.1.0",
  "description": "Performant React forms where every field is a Jotai atom",
  "keywords": [
    "react",
    "form",
    "forms",
    "jotai",
    "field-array",
    "validation"
  ],
  "license": "MIT",
  "author": "Wit By Bit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witbybit/wit-form.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check-exports": "attw --pack . --profile esm-only && publint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check-exports",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "jotai": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jotai": ">=3.0.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": ">=18.0.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
